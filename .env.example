# Remplace ces valeurs par tes liens officiels avant la campagne publique.

# Casinos partenaires (liens d'affiliation)
NEXT_PUBLIC_CELSIUS_AFFILIATE_URL=https://celsius.games/UOpYoHXSoi
NEXT_PUBLIC_STAKE_AFFILIATE_URL=https://stake.bet/?c=RNOcBLU2
# Les macros {sub_id_1} / {click_id} restent litterales faute de tracker, mais
# l'identifiant d'affiliation est dans le chemin : l'attribution est preservee.
NEXT_PUBLIC_FIERYPLAY_AFFILIATE_URL=https://promo-fieryplay.com/l/6a96a8719ad17ced6a0dae82?sub_id={sub_id_1}&click_id={click_id}
NEXT_PUBLIC_ZEPPELIN_AFFILIATE_URL=https://zplncheck.com/r/GCRG5VCF

# Communaute & streaming
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/ytMWdgCPNF
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/+rXPQXhTaEKZjMjc0
NEXT_PUBLIC_STREAM_URL=https://rumble.com/c/c-7946190?e9s=src_v1_cbl

# URL canonique du site (sans slash final) : sert aux metadonnees, au sitemap et au JSON-LD
NEXT_PUBLIC_SITE_URL=https://www.spin-district.fun

# --- Supabase (comptes & points) --------------------------------------
# Cles publiques : elles sont inlinees dans le bundle client, c'est prevu.
# Supabase Studio > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Duree de validite d'un code !verify, en secondes.
# Doit rester identique a VERIFY_CODE_TTL cote bot Python.
VERIFY_CODE_TTL=600

# NOTE : la cle sb_secret_... (service_role) n'est utilisee NULLE PART ici.
# Ne l'ajoutez jamais avec un prefixe NEXT_PUBLIC_ : elle contourne RLS et
# serait lisible par tous les visiteurs dans le bundle JavaScript.
