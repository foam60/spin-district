NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Duree de validite d'un code !verify, en secondes.
# Doit rester identique a VERIFY_CODE_TTL cote bot Python.
VERIFY_CODE_TTL=600

# NOTE : la cle sb_secret_... (service_role) n'est utilisee NULLE PART ici.
# Ne l'ajoutez jamais avec un prefixe NEXT_PUBLIC_ : elle contourne RLS et
# serait lisible par tous les visiteurs dans le bundle JavaScript.
